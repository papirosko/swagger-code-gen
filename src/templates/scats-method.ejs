    /**
     * <%= method.method.toUpperCase() %> <%= method.path %>
    <% if (method.summary) { -%>
     * @summary <%= method.summary %>
    <% } -%>
    <% if (method.description) { -%>
     * @description <%= method.description %>
    <% } -%>
    <% if (method.wrapParamsInObject) { -%>
     * @param {Object} params
    <% } -%>
    <% method.parameters.foreach(p => { -%>
     * @param {<%= p.jsType %>} <%= method.wrapParamsInObject ? 'params.' : '' %><%= p.uniqueName %> <%= p.description.getOrElseValue('')%>
    <% }); -%>
    <%_ if (body.nonEmpty) { -%>
     * @param {<%= body.get.body.jsType %>} body <%= method.bodyDescription.getOrElseValue('') %>
    <%_ } -%>
     * @param {RequestOptions} requestOptions Additional request params
     * @return {<%= method.response.noContent ? 'void' : (method.response.parseMode === 'bytes' ? (targetNode ? 'Buffer' : 'ArrayBuffer') : method.response.responseType) %>} <%= method.response.description %>
     */
    async <%= method.endpointName %><%= body.map(b => b.suffix).getOrElseValue('') %>(
        <%_ if (!method.wrapParamsInObject) { -%>
        <%_ method.parameters.foreach(p => { -%>
        <%= p.uniqueName %>: <%- p.required && !p.nullable ? p.jsType : `Option<${p.jsType}> = none` %>,
        <%_ }) -%>
        <%_ } else { -%>
        params: {
            <%_ method.parameters.foreach(p => { -%>
            <%= p.uniqueName %><%= p.required && !p.nullable ? '' : '?'%>: <%- p.jsType %>,
            <%_ }) -%>
        },
        <%_ } -%>
        <%_ body.foreach(body => { -%>
        body: <%- body.body.scatsWrapperType %>,
        <%_ }); -%>
        requestOptions: RequestOptions = {}
    ): Promise<TryLike<<% if (method.response.noContent) { %>void<% } else if (method.response.parseMode === 'bytes') { %><% if (targetNode) { %>Buffer<% } else { %>ArrayBuffer<% } %><% } else { %><%- method.response.asProperty.scatsWrapperType %><% } %>>> {
        const mergedRequestOptions = this.mergeRequestOptions(requestOptions);
        return (await Try.promise(() =>
                <%= method.endpointName %><%= body.map(b => b.suffix).getOrElseValue('') %>(
                    <%_ if (!method.wrapParamsInObject) { -%>
                    <%_ method.parameters.foreach(p => { -%>
                    <%= p.uniqueName %><%- p.required && !p.nullable ? '' : `.orUndefined` %>,
                    <%_ }) -%>
                    <%_ } else { -%>
                    params,
                    <%_ } -%>
                    <%_ body.map(x => x.body).foreach(body => { -%>
                    <%_ if (body.schemaType === 'object') { _%>
                    body.toJson,
                    <%_ } else if (body.schemaType === 'property') { _%>
                    <%_ if (body.isArray) { _%>
                    body.map(value => scatsToJsonValue(value)).toArray,
                    <%_ } else if (!body.required) { -%>
                    body.map(value => scatsToJsonValue(value)).orUndefined,
                    <%_ } else { -%>
                    scatsToJsonValue(body),
                    <%_ } -%>
                    <%_ } else { -%>
                    body,
                    <%_ } -%>
                    <%_ }); -%>
                    mergedRequestOptions
                )
            ))
            <%_ if (!method.response.noContent && method.response.parseMode !== 'bytes') { _%>
            <%_ if (method.response.asProperty.referencesObject) { _%>
            <%_ if (method.response.asProperty.required && !method.response.asProperty.nullable) { _%>
            .map(res => <%- method.response.asProperty.scatsWrapperType %>.fromJson(res))
            <%_ } else { _%>
            .map(res => option(res).map(r => <%- method.response.asProperty.normalType %>Dto.fromJson(r)))
            <%_ } _%>
            <%_ } else if (method.response.asProperty.isArray) { _%>
            .map(res => (Collection.from(option(res).getOrElseValue([]))
            <%_ if (method.response.asProperty.itemScatsWrapperTypeHasFromJson) { _%>
            .map(i => <%- method.response.asProperty.itemScatsWrapperType %>.fromJson(i))
            <%_ } _%>
            ) as unknown as <%- method.response.asProperty.scatsWrapperType %>)
            <%_ } else if (!method.response.asProperty.required || method.response.asProperty.nullable) { _%>
            .map(res => option(res) as unknown as <%- method.response.asProperty.scatsWrapperType %>)
            <%_ } else { _%>
            .map(res => res as unknown as <%- method.response.asProperty.scatsWrapperType %>)
            <%_ } _%>;
            <%_ } else { _%>;
            <%_ } _%>
    }
