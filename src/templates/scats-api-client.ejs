export class ApiClient {

    constructor(readonly requestOptions: Readonly<RequestOptions> = defReqOpts()) {
    }

    private mergeRequestOptions(requestOptions: RequestOptions = {}): RequestOptions {
        return {
            ...this.requestOptions,
            ...requestOptions,
            headers: {
                ...(this.requestOptions.headers ?? {}),
                ...(requestOptions.headers ?? {})
            }
        };
    }


    <%
    methods.foreach(method => {
        if (method.body.nonEmpty) {
            method.body.foreach(body => {
    %>
    <%- include('scats-method.ejs', {method: method, body: scatsLib.some(body)}); %>
    <%
            });
        } else {
    %>
    <%- include('scats-method.ejs', {method: method, body: scatsLib.none }); %>
    <%
        }
    });
    %>

}
