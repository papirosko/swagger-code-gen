<%_ const sanitizeDocLine = (line) => String(line).replace(/\*\//g, '*\\/');
const renderDocLines = (text) => String(text).split(/\r?\n/).map(line => `     ${sanitizeDocLine(line)}`); -%>
<%_ if (schema.schemaType === 'object') { -%>
<%_ const allProps = schema.propsIncludingInherited(); -%>
export class <%= schema.normalName %>Dto {

    /**
    <%_ allProps.foreach(p => { -%>
    <%_ renderDocLines(` * @param ${p.normalisedName} ${p.description.getOrElseValue('')}`).forEach(line => { -%>
<%= line %>
    <%_ }); -%>
    <%_ }); -%>
    */
    constructor(
        <%_ allProps.foreach(p => { -%>
        readonly <%= p.normalisedName %>: <%- p.scatsWrapperType %>,
        <%_ }); -%>
    ) {}


    static fromJson(json: <%= schema.normalName %>): <%= schema.normalName %>Dto {
        return new <%= schema.normalName %>Dto(
            <%_ allProps.foreach(p => { _%>
            <%_ if (p.referencesObject) { _%>
            <%_ if (p.required && !p.nullable) { _%>
            <%- p.scatsWrapperType %>.fromJson(json['<%= p.name %>']),
            <%_ } else { _%>
            option(json['<%= p.name %>']).map(_ => <%- p.normalType %>Dto.fromJson(_)),
            <%_ } _%>
            <%_ } else if (p.isArray || p.scatsWrapperTypeIsCollection) { _%>
            (Collection.from(option(json['<%= p.name %>']).getOrElseValue([]))
                <% if (p.itemScatsWrapperTypeHasFromJson) { _%>.map(i => <%- p.itemScatsWrapperType %>.fromJson(i))<%_ }  _%>) as unknown as <%- p.scatsWrapperType %>,
            <%_ } else if (p.required && !p.nullable) { _%>
            json['<%= p.name %>'] as unknown as <%- p.scatsWrapperType %>,
            <%_ } else { _%>
            option(json['<%= p.name %>']) as unknown as <%- p.scatsWrapperType %>,
            <%_ } _%>
            <%_ }); _%>
        );
    }

    copy(fields: Partial<<%= schema.normalName %>Dto>): <%= schema.normalName %>Dto {
        return new <%= schema.normalName %>Dto(
        <%_ allProps.foreach(p => { -%>
            fields.<%= p.normalisedName %> === undefined ? this.<%= p.normalisedName %> : fields.<%= p.normalisedName %>,
        <%_ });  -%>
        );
    }

    get toJson(): <%= schema.normalName %> {
        return {
            <%_ allProps.foreach(p => { _%>
            <%_ if (p.isArray || p.scatsWrapperTypeIsCollection) { _%>
            '<%= p.name %>': this.<%= p.normalisedName %>
                .map(value => scatsToJsonValue(value))
                .toArray,
            <%_ } else if (p.required && !p.nullable) { _%>
            '<%= p.name %>': scatsToJsonValue(this.<%= p.normalisedName %>),
            <%_ } else if (p.required && p.nullable) { _%>
            '<%= p.name %>': this.<%= p.normalisedName %>.map(value => scatsToJsonValue(value)).orNull,
            <%_ } else { _%>
            '<%= p.name %>': this.<%= p.normalisedName %>.map(value => scatsToJsonValue(value)).orUndefined,
            <%_ } _%>
            <%_ }); _%>
        };
    }
}

<%_ } -%>
