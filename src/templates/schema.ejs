<%_ if (schema.schemaType === 'object') { -%>
export interface <%= schema.normalName %><%= schema.parentsString%> {
    <%_ schema.properties.foreach(p => { -%>
    <%_ p.description.foreach(d => { -%>
    /**
     * <%= d %>
     */
    <%_ }); -%>
    readonly '<%= p.name %>'<%= !p.required ? '?' : '' %>: <%- p.jsType %>;
    <%_ }); -%>
}
<%_ } if (schema.schemaType === 'enum') { -%>
<%_ schema.description.foreach(d => { -%>
/**
 * <%= d %>
 */
<%_ }); -%>
<%_ const isValidIdent = (s) => typeof s === 'string' && /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(s);
    const allValid = schema.values.forall(p => isValidIdent(p));
-%>
<%_ if (allValid) { -%>
export enum <%= schema.normalName %> {
    <%_ schema.values.foreach(p => { -%>
    <%= p %> = '<%= p %>',
    <%_ }); -%>
}
<%_ } else { -%>
export type <%= schema.normalName %> = <%- schema.values.map(p => p == null ? 'null' : "'" + String(p).replace(/'/g, "\\'") + "'").mkString(' | ') %>;
<%_ } -%>
<%_ } -%>
