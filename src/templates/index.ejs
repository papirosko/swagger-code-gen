function objectToFormWwwEncoded(o: Record<string, any>): string {
    return Object.keys(o)
        .filter(k => o[k] !== undefined && o[k] !== null)
        .map(k => `${k}=${encodeURIComponent(valueToString(o[k]))}`)
        .join('&');
}

